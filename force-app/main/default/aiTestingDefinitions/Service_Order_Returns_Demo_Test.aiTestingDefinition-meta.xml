<?xml version="1.0" encoding="UTF-8"?>
<AiTestingDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Demo org, test data only. 20 scripted conversations.</description>
    <name>Service_Order_Returns_Demo_Test</name>
    <subjectName>Service_Order_Returns_Agent</subjectName>
    <subjectType>AGENT</subjectType>
    <subjectVersion>v1</subjectVersion>
    <testCase>
        <number>1</number>
        <inputs>
            <utterance>Where is my order 00000109?</utterance>
        </inputs>
        <scorer>
            <name>topic_sequence_match</name>
            <expectedValue>order_status</expectedValue>
        </scorer>
        <scorer>
            <name>action_sequence_match</name>
            <expectedValue>get_order_details</expectedValue>
        </scorer>
        <scorer>
            <name>response_match</name>
            <expectedValue>Agent answers In Transit via UPS with the delivery estimate and tracking text.</expectedValue>
        </scorer>
    </testCase>
