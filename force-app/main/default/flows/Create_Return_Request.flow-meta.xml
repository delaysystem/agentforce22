    <decisions>
        <name>Check_Found</name>
        <label>Check Found</label>
        <locationX>50</locationX>
        <locationY>220</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Order_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Product_Type</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Eligibility</name>
        <label>Check Eligibility</label>
        <locationX>50</locationX>
        <locationY>700</locationY>
        <defaultConnector>
            <targetReference>Set_Return_Fields</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Eligible</defaultConnectorLabel>
        <rules>
            <name>Is_Lost_Or_Damaged</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order.Shipment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lost</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Order.Shipment_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Damaged</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Escalate_Lost_Damaged</targetReference>
            </connector>
            <label>Lost Or Damaged</label>
        </rules>
        <rules>
            <name>Is_Non_Returnable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order.Product_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Non_Returnable_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Non_Returnable</targetReference>
            </connector>
            <label>Non Returnable</label>
        </rules>
        <rules>
            <name>Is_Not_Delivered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Order.Shipment_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Delivered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Not_Delivered</targetReference>
            </connector>
            <label>Not Delivered</label>
        </rules>
        <rules>
            <name>Is_Out_Of_Window</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Days_Since_Delivery</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Return_Window_Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Out_Of_Window</targetReference>
            </connector>
            <label>Out Of Window</label>
        </rules>
    </decisions>
    <description>Demo project in a Salesforce demo org, test data only. Agent action: check return eligibility by delivery date (30-day window), shipment state, and product type; create a Return_Request__c record only when eligible. Never creates a false return: out-of-window, lost/damaged, and Final Sale orders escalate instead.</description>
    <formulas>
        <name>Basis_Date</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Order.Delivered_Date__c}), {!Get_Order.EffectiveDate}, {!Get_Order.Delivered_Date__c})</expression>
    </formulas>
    <formulas>
        <name>Days_Since_Delivery</name>
        <dataType>Number</dataType>
        <expression>TODAY() - {!Basis_Date}</expression>
        <scale>0</scale>
    </formulas>
