    </constants>
    <constants>
        <name>Non_Returnable_Type</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Final Sale</stringValue>
        </value>
        <description>Origin: config/agent/demo-config.json nonReturnableProductTypes (Product2.Family value excluded from returns).</description>
    </constants>
    <constants>
